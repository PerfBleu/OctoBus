# Offline OctoBus image: pre-imports every service under services/ at build time.
#
# Build (from repo root; compile the binary for the daemon architecture first):
#
#   mkdir -p dist
#   GOOS=linux GOARCH=amd64 bash ./scripts/build-octobus.sh dist/octobus-linux-amd64
#   docker build -f docker/Dockerfile.offline -t octobus:offline .
#
# Run with a fresh named volume; Docker copies the baked data dir into the volume
# on first start. Set OCTOBUS_BOOTSTRAP_ADMIN_TOKEN on first production start.
#
# syntax=docker/dockerfile:1

FROM ubuntu:26.04 AS tentacles-builder

ENV DEBIAN_FRONTEND=noninteractive

# Default npm mirror for image builds in CN; override: --build-arg NPM_REGISTRY=https://registry.npmjs.org
ARG NPM_REGISTRY=https://registry.npmmirror.com
ENV NPM_CONFIG_REGISTRY=${NPM_REGISTRY} \
	NPM_CONFIG_FETCH_TIMEOUT=600000 \
	NPM_CONFIG_FETCH_RETRIES=5

RUN apt-get update \
	&& apt-get install -y --no-install-recommends \
		ca-certificates \
		curl \
		git \
		nodejs \
		npm \
		protobuf-compiler \
		libprotobuf-dev \
		sqlite3 \
	&& rm -rf /var/lib/apt/lists/*

ARG TARGETARCH
WORKDIR /build
COPY dist/octobus-linux-${TARGETARCH} /usr/local/bin/octobus
COPY sdk/ ./sdk/
COPY services/ ./services/
COPY docker/bake-tentacles-data.sh /usr/local/bin/bake-tentacles-data.sh

RUN chmod +x /usr/local/bin/bake-tentacles-data.sh \
	&& npm --prefix ./sdk ci \
	&& npm --prefix ./sdk run build \
	&& npm --prefix ./services install --omit=dev \
	&& mkdir -p /var/lib/octobus-seed \
	&& /usr/local/bin/bake-tentacles-data.sh \
		/usr/local/bin/octobus \
		/build/services \
		/var/lib/octobus-seed

FROM ubuntu:26.04

ENV DEBIAN_FRONTEND=noninteractive \
	OCTOBUS_ADDR=0.0.0.0:9000 \
	OCTOBUS_DATA_DIR=/var/lib/octobus

RUN apt-get update \
	&& apt-get install -y --no-install-recommends \
		ca-certificates \
		curl \
		git \
		nodejs \
		npm \
		protobuf-compiler \
		libprotobuf-dev \
	&& rm -rf /var/lib/apt/lists/* \
	&& groupadd --system octobus \
	&& useradd --system --gid octobus --home-dir /var/lib/octobus --create-home --shell /usr/sbin/nologin octobus

ARG TARGETARCH
COPY dist/octobus-linux-${TARGETARCH} /usr/local/bin/octobus
COPY --from=tentacles-builder --chown=octobus:octobus /var/lib/octobus-seed/ /var/lib/octobus/

USER octobus
WORKDIR /var/lib/octobus
VOLUME ["/var/lib/octobus"]
EXPOSE 9000

ENTRYPOINT ["octobus"]
CMD ["serve"]
