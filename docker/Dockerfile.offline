# Offline OctoBus image: pre-imports every service under services/ at build time.
#
# Build (from repo root; compile the binary for the daemon architecture first):
#
#   mkdir -p dist
#   GOOS=linux GOARCH=amd64 bash ./scripts/build-octobus.sh dist/octobus-linux-amd64
#   docker build --progress=plain -f docker/Dockerfile.offline -t octobus:offline .
#
# Run with a fresh named volume; Docker copies the baked data dir into the volume
# on first start. Set OCTOBUS_BOOTSTRAP_ADMIN_TOKEN on first production start.
#
# syntax=docker/dockerfile:1.4

FROM ubuntu:26.04 AS tentacles-builder

ENV DEBIAN_FRONTEND=noninteractive

# apt uses USTC. USTC no longer serves an npm registry (package metadata and
# tarballs return 404), so npm uses npmmirror. Override with --build-arg NPM_REGISTRY=...
ARG NODE_VERSION=22.13.1
ARG NODE_DIST_BASE=https://mirrors.tuna.tsinghua.edu.cn/nodejs-release
ARG NPM_REGISTRY=https://registry.npmmirror.com
ENV NPM_CONFIG_REGISTRY=${NPM_REGISTRY} \
	NPM_CONFIG_FETCH_TIMEOUT=600000 \
	NPM_CONFIG_FETCH_RETRIES=5 \
	NPM_CONFIG_LOGLEVEL=info \
	NPM_CONFIG_PROGRESS=true

COPY docker/apt-use-ustc-mirror.sh /usr/local/bin/apt-use-ustc-mirror.sh
COPY docker/apt-bootstrap.sh /usr/local/bin/apt-bootstrap.sh
COPY docker/install-node-ustc.sh /usr/local/bin/install-node-ustc.sh
COPY docker/npm-with-progress.sh /usr/local/bin/npm-with-progress.sh
RUN chmod +x /usr/local/bin/apt-use-ustc-mirror.sh \
		/usr/local/bin/apt-bootstrap.sh \
		/usr/local/bin/install-node-ustc.sh \
		/usr/local/bin/npm-with-progress.sh

# Apt cache mounts speed rebuilds; logs need: docker build --progress=plain
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
	--mount=type=cache,target=/var/lib/apt,sharing=locked \
	/usr/local/bin/apt-bootstrap.sh \
		ca-certificates \
		curl \
		git \
		protobuf-compiler \
		libprotobuf-dev \
		sqlite3 \
	&& rm -rf /var/lib/apt/lists/*

ARG NODE_VERSION
ARG NODE_DIST_BASE
RUN NODE_VERSION="${NODE_VERSION}" NODE_DIST_BASE="${NODE_DIST_BASE}" /usr/local/bin/install-node-ustc.sh

ARG TARGETARCH
WORKDIR /build
COPY dist/octobus-linux-${TARGETARCH} /usr/local/bin/octobus
COPY sdk/ ./sdk/
COPY services/ ./services/
COPY docker/bake-tentacles-data.sh /usr/local/bin/bake-tentacles-data.sh

RUN chmod +x /usr/local/bin/bake-tentacles-data.sh

RUN --mount=type=cache,target=/root/.npm,sharing=locked \
	/usr/local/bin/npm-with-progress.sh ./sdk ci

RUN /usr/local/bin/npm-with-progress.sh ./sdk run build

RUN --mount=type=cache,target=/root/.npm,sharing=locked \
	/usr/local/bin/npm-with-progress.sh ./services install --omit=dev

RUN echo "[bake $(date -u +%H:%M:%S)] import all tentacles" \
	&& mkdir -p /var/lib/octobus-seed \
	&& /usr/local/bin/bake-tentacles-data.sh \
		/usr/local/bin/octobus \
		/build/services \
		/var/lib/octobus-seed

FROM ubuntu:26.04

ENV DEBIAN_FRONTEND=noninteractive \
	OCTOBUS_ADDR=0.0.0.0:9000 \
	OCTOBUS_DATA_DIR=/var/lib/octobus

ARG NODE_VERSION=22.13.1
ARG NODE_DIST_BASE=https://mirrors.tuna.tsinghua.edu.cn/nodejs-release
COPY docker/apt-use-ustc-mirror.sh /usr/local/bin/apt-use-ustc-mirror.sh
COPY docker/apt-bootstrap.sh /usr/local/bin/apt-bootstrap.sh
COPY docker/install-node-ustc.sh /usr/local/bin/install-node-ustc.sh
RUN chmod +x /usr/local/bin/apt-use-ustc-mirror.sh \
		/usr/local/bin/apt-bootstrap.sh \
		/usr/local/bin/install-node-ustc.sh

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
	--mount=type=cache,target=/var/lib/apt,sharing=locked \
	/usr/local/bin/apt-bootstrap.sh \
		ca-certificates \
		curl \
		git \
		protobuf-compiler \
		libprotobuf-dev \
	&& rm -rf /var/lib/apt/lists/* \
	&& NODE_VERSION="${NODE_VERSION}" NODE_DIST_BASE="${NODE_DIST_BASE}" /usr/local/bin/install-node-ustc.sh \
	&& groupadd --system octobus \
	&& useradd --system --gid octobus --home-dir /var/lib/octobus --create-home --shell /usr/sbin/nologin octobus

ARG TARGETARCH
COPY dist/octobus-linux-${TARGETARCH} /usr/local/bin/octobus
COPY --from=tentacles-builder --chown=octobus:octobus /var/lib/octobus-seed/ /var/lib/octobus/

USER octobus
WORKDIR /var/lib/octobus
VOLUME ["/var/lib/octobus"]
EXPOSE 9000

ENTRYPOINT ["octobus"]
CMD ["serve"]
